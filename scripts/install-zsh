#!/usr/bin/env bash
set -euo pipefail

REPO="${REPO:-$(cd "$(dirname "$0")/.." && pwd)}"

ln -sfn "$REPO/zsh/.zshrc" "$HOME/.zshrc"
ln -sfn "$REPO/zsh/.zprofile" "$HOME/.zprofile"
ln -sfn "$REPO/zsh/.zshenv" "$HOME/.zshenv"

touch "$HOME/.zsh_private"
touch "$HOME/.zsh_personal"

if [[ -f "$REPO/aliases/aliases.zsh" ]]; then
  ln -sfn "$REPO/aliases/aliases.zsh" "$HOME/.aliases"
fi
