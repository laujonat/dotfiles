#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BREWFILE="${DOTFILES_DIR}/Brewfile"

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

ensure_macos_prereqs() {
  if ! xcode-select -p >/dev/null 2>&1; then
    echo "Installing Xcode Command Line Tools..."
    xcode-select --install || true
    echo "Finish the Command Line Tools install, then rerun."
    exit 1
  fi
}

ensure_linux_prereqs() {
  if have_cmd apt-get; then
    sudo apt-get update
    sudo apt-get install -y build-essential curl file git
  else
    echo "Unsupported Linux package manager for preflight setup."
    echo "Install curl, file, git, and build tools manually, then rerun."
    exit 1
  fi
}

ensure_prereqs() {
  case "$(uname -s)" in
    Darwin) ensure_macos_prereqs ;;
    Linux)  ensure_linux_prereqs ;;
    *)
      echo "Unsupported OS: $(uname -s)"
      exit 1
      ;;
  esac
}

load_brew_env() {
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  else
    echo "brew not found after install"
    exit 1
  fi
}

install_homebrew() {
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  load_brew_env
}

main() {
  if ! have_cmd brew; then
    ensure_prereqs
    install_homebrew
  else
    load_brew_env || true
  fi

  brew update

  if [[ -f "$BREWFILE" ]]; then
    brew bundle --file="$BREWFILE"
  else
    echo "Missing Brewfile: $BREWFILE"
    exit 1
  fi
}

main "$@"
